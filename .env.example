# Browser-visible identifier for the published Agent.
VITE_OPENHEX_AGENT_ID=

# Optional. The SDK defaults to the production OpenHex API.
VITE_OPENHEX_API_BASE_URL=https://api.openhex.tech

# Optional. Consecutive time without any Agent event before the UI times out.
VITE_OPENHEX_IDLE_TIMEOUT_MS=300000

# Server-only Vercel Function settings. Never add a VITE_ prefix to the key.
OPENHEX_WORKSPACE_SLUG=
OPENHEX_WORKSPACE_KEY=
